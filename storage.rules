rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // PDFs are stored at documents/{ownerUid}/{documentId}/{filename}
    match /documents/{ownerUid}/{documentId}/{filename} {
      // Only the owner can upload/delete their own PDFs.
      allow write: if request.auth != null && request.auth.uid == ownerUid;

      // Any signed-in user with document access can read the PDF.
      allow read: if request.auth != null &&
        firestore.exists(
          /databases/(default)/documents/documents/$(documentId)/access/$(request.auth.uid)
        );
    }
  }
}